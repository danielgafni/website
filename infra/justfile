stack := "danielgafni/website/prod"

# Provision the Cloudflare Pages project + DNS with Pulumi.
deploy-infra:
    pulumi up --stack {{stack}}

preview-infra:
    pulumi preview --stack {{stack}}

# Build the site with Zensical and upload it to Cloudflare Pages.
deploy:
    cd ../www && zensical build --clean
    wrangler pages deploy ../www/site --project-name=gafni-dev --branch=master
