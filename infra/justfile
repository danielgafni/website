stack := "danielgafni/website/prod"

# Provision the Cloudflare Pages project + DNS with Pulumi.
deploy-infra:
    pulumi up --stack {{stack}}

preview-infra:
    pulumi preview --stack {{stack}}

# Build the site with Nix and upload it to Cloudflare Pages.
deploy:
    nix build ../www --out-link result
    wrangler pages deploy result --project-name=gafni-dev --branch=master
